{
  "name": "@virgil/tools",
  "version": "0.0.1",
  "description": "Virgil development workflow tools.",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "virgil-probe": "./dist/main.js"
  },
  "scripts": {
    "build": "nest build && node -e \"require('node:fs').chmodSync('dist/main.js', 0o755)\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:static": "pnpm run lint && pnpm run format:check && tsc -p tsconfig.json --noEmit",
    "test:dynamic": "vitest run --coverage"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "nest-commander": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "source-map-support": "catalog:",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  }
}
