{
  "name": "@virgil/pw-cdp",
  "version": "0.0.1",
  "description": "Playwright CDP browser automation for authenticated enterprise web UIs (Jira, Confluence, Monday, Slack, Teams).",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:static": "pnpm run lint && pnpm run format:check && tsc -p tsconfig.json --noEmit",
    "test:dynamic": "vitest run --coverage",
    "test:doctor": "pnpm run test:static && pnpm run build"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "peerDependencies": {
    "playwright": "1.61.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  }
}
