{
  "name": "@virgil/cli",
  "version": "0.0.1",
  "description": "Virgil command-line interface.",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "virgil": "./dist/main.js"
  },
  "scripts": {
    "build": "nest build && node -e \"require('node:fs').chmodSync('dist/main.js', 0o755)\"",
    "build:sea": "node scripts/build-sea.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:static": "pnpm run lint && pnpm run format:check && tsc -p tsconfig.json --noEmit",
    "test:dynamic": "vitest run --coverage",
    "test:doctor": "pnpm run test:static && pnpm run test:dynamic",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "db:benchmark": "node scripts/benchmark-persistence.mjs"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "better-sqlite3": "catalog:",
    "drizzle-orm": "catalog:",
    "nest-commander": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "ulid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "catalog:",
    "esbuild": "catalog:",
    "oxlint": "catalog:",
    "postject": "catalog:",
    "prettier": "catalog:",
    "source-map-support": "catalog:",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  }
}
