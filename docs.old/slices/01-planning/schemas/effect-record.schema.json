{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.virgil.dev/planning-slice1/v1alpha1/effect-record.schema.json",
  "title": "Virgil EffectRecord",
  "type": "object",
  "required": [
    "protocol_version",
    "effect_id",
    "request_id",
    "causation_id",
    "kind",
    "resource",
    "adapter",
    "capability",
    "policy_decision",
    "requested",
    "occurred",
    "observed",
    "evidence"
  ],
  "properties": {
    "protocol_version": {
      "const": "virgil.dev/planning-slice2/v1alpha1"
    },
    "effect_id": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "causation_id": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "kind": {
      "enum": ["read", "write", "external_call"]
    },
    "resource": {
      "$ref": "common.schema.json#/$defs/ResourceRef"
    },
    "adapter": {
      "$ref": "common.schema.json#/$defs/AdapterRef"
    },
    "capability": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "policy_decision": {
      "enum": ["authorized", "denied", "unsupported"]
    },
    "requested": {
      "type": "object"
    },
    "occurred": {
      "type": "boolean"
    },
    "observed": {
      "type": ["object", "null"]
    },
    "state_before": {
      "$ref": "common.schema.json#/$defs/ResourceRef"
    },
    "state_after": {
      "$ref": "common.schema.json#/$defs/ResourceRef"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/ResourceRef"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "policy_decision": {
            "enum": ["denied", "unsupported"]
          }
        },
        "required": ["policy_decision"]
      },
      "then": {
        "properties": {
          "occurred": { "const": false },
          "observed": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "occurred": { "const": true }
        },
        "required": ["occurred"]
      },
      "then": {
        "properties": {
          "policy_decision": { "const": "authorized" },
          "observed": { "type": "object" }
        }
      },
      "else": {
        "properties": {
          "observed": { "type": "null" }
        }
      }
    }
  ],
  "additionalProperties": false
}
