{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.virgil.dev/planning-slice1/v1alpha1/doc-frontmatter.schema.json",
  "title": "Virgil Doc Frontmatter",
  "description": "JSON frontmatter for all Virgil-managed documents: idea, requirements, design, and tasks.",
  "type": "object",
  "required": [
    "schema",
    "protocol_version",
    "doc_kind",
    "project_id",
    "content_digest",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema": {
      "const": "virgil.dev/doc/v1alpha1"
    },
    "protocol_version": {
      "const": "virgil.dev/planning-slice2/v1alpha1"
    },
    "doc_kind": {
      "enum": ["idea", "requirement", "design", "task"]
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "slug": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "category": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "status": {
      "enum": ["backlog", "refined", "active", "done", "released"]
    },
    "refs": {
      "$ref": "#/$defs/TaskRefs"
    },
    "content_digest": {
      "$ref": "common.schema.json#/$defs/SHA256"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "doc_kind": { "const": "task" } },
        "required": ["doc_kind"]
      },
      "then": {
        "required": ["status", "refs"]
      }
    },
    {
      "if": {
        "properties": { "doc_kind": { "enum": ["requirement", "design", "task"] } },
        "required": ["doc_kind"]
      },
      "then": {
        "required": ["slug"]
      }
    }
  ],
  "$defs": {
    "TaskRefs": {
      "type": "object",
      "properties": {
        "requirements": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "design": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "implements": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
