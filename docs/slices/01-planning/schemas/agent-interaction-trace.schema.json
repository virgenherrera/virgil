{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.virgil.dev/planning-slice1/v1alpha1/agent-interaction-trace.schema.json",
  "title": "Virgil AgentInteractionTrace",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_version",
    "trace_id",
    "fixture",
    "layer",
    "adapter_profile",
    "runtime_capabilities",
    "started_at",
    "ended_at",
    "entries",
    "outcome",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "virgil.dev/agent-interaction-trace/v1alpha1"
    },
    "protocol_version": {
      "const": "virgil.dev/planning-slice1/v1alpha1"
    },
    "trace_id": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "fixture": {
      "$ref": "#/$defs/FixtureRef"
    },
    "layer": {
      "enum": ["T0", "T1", "T2"]
    },
    "adapter_profile": {
      "$ref": "scenario-fixture.schema.json#/$defs/AdapterProfile"
    },
    "runtime_capabilities": {
      "$ref": "common.schema.json#/$defs/HostRef"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/TraceEntry"
      }
    },
    "outcome": {
      "$ref": "scenario-fixture.schema.json#/$defs/ExpectedOutcome"
    },
    "redactions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Redaction"
      }
    },
    "integrity": {
      "$ref": "#/$defs/Integrity"
    }
  },
  "$defs": {
    "FixtureRef": {
      "type": "object",
      "required": ["fixture_id", "fixture_revision", "digest"],
      "properties": {
        "fixture_id": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "fixture_revision": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        }
      },
      "additionalProperties": false
    },
    "ContextRequest": {
      "type": "object",
      "required": ["brief_id", "requested_sources", "max_bytes"],
      "properties": {
        "brief_id": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "requested_sources": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/NonEmptyString"
          },
          "uniqueItems": true
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "ContextDelivery": {
      "type": "object",
      "required": ["brief_id", "sources", "bytes"],
      "properties": {
        "brief_id": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ResourceRef"
          }
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "TraceEntry": {
      "type": "object",
      "required": [
        "entry_id",
        "sequence",
        "timestamp",
        "kind",
        "process_id",
        "actor",
        "correlation_id",
        "causation_id",
        "evidence"
      ],
      "properties": {
        "entry_id": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "enum": [
            "instructions_delivered",
            "discovery_decision",
            "activation_decision",
            "operation_requested",
            "operation_decided",
            "context_requested",
            "context_delivered",
            "guard_result",
            "gate_result",
            "effect_observed",
            "stop",
            "retry",
            "escalation",
            "recovery",
            "outcome"
          ]
        },
        "process_id": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "actor": {
          "$ref": "common.schema.json#/$defs/ActorRef"
        },
        "correlation_id": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "causation_id": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "operation_request": {
          "$ref": "operation-request.schema.json"
        },
        "operation_result": {
          "$ref": "operation-result.schema.json"
        },
        "effect": {
          "$ref": "effect-record.schema.json"
        },
        "context_request": {
          "$ref": "#/$defs/ContextRequest"
        },
        "context_delivery": {
          "$ref": "#/$defs/ContextDelivery"
        },
        "payload": {
          "type": "object"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ResourceRef"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": { "const": "operation_requested" }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["operation_request"],
            "not": {
              "anyOf": [
                { "required": ["operation_result"] },
                { "required": ["effect"] },
                { "required": ["context_request"] },
                { "required": ["context_delivery"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "operation_decided" }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["operation_result"],
            "not": {
              "anyOf": [
                { "required": ["operation_request"] },
                { "required": ["effect"] },
                { "required": ["context_request"] },
                { "required": ["context_delivery"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "effect_observed" }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["effect"],
            "not": {
              "anyOf": [
                { "required": ["operation_request"] },
                { "required": ["operation_result"] },
                { "required": ["context_request"] },
                { "required": ["context_delivery"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "context_requested" }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["context_request"],
            "not": {
              "anyOf": [
                { "required": ["operation_request"] },
                { "required": ["operation_result"] },
                { "required": ["effect"] },
                { "required": ["context_delivery"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "context_delivered" }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["context_delivery"],
            "not": {
              "anyOf": [
                { "required": ["operation_request"] },
                { "required": ["operation_result"] },
                { "required": ["effect"] },
                { "required": ["context_request"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "not": {
                  "enum": [
                    "operation_requested",
                    "operation_decided",
                    "effect_observed",
                    "context_requested",
                    "context_delivered"
                  ]
                }
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["payload"],
            "not": {
              "anyOf": [
                { "required": ["operation_request"] },
                { "required": ["operation_result"] },
                { "required": ["effect"] },
                { "required": ["context_request"] },
                { "required": ["context_delivery"] }
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "Redaction": {
      "type": "object",
      "required": ["entry_id", "field", "reason"],
      "properties": {
        "entry_id": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "field": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "reason": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "Integrity": {
      "type": "object",
      "required": ["digest", "canonicalization"],
      "properties": {
        "digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "canonicalization": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
