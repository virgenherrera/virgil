{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.virgil.dev/planning-slice1/v1alpha1/revision-envelope.schema.json",
  "title": "Virgil Revision Envelope",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_version",
    "revision_id",
    "artifact_kind",
    "change_id",
    "project_id",
    "state",
    "upstream_refs",
    "content",
    "provenance",
    "created_at",
    "idempotency_key",
    "request_id"
  ],
  "properties": {
    "schema_version": {
      "const": "virgil.dev/revision-envelope/v1alpha1"
    },
    "protocol_version": {
      "const": "virgil.dev/planning-slice1/v1alpha1"
    },
    "revision_id": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "artifact_kind": {
      "enum": ["idea", "spec", "design", "tasks", "handoff"]
    },
    "change_id": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "state": {
      "enum": ["draft", "awaiting_approval", "approved", "withdrawn", "superseded"]
    },
    "upstream_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/UpstreamRef"
      },
      "uniqueItems": true
    },
    "content": {
      "$ref": "common.schema.json#/$defs/ResourceRef"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/SourceProvenance"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "idempotency_key": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "approved_by": {
      "$ref": "common.schema.json#/$defs/ActorRef"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": { "const": "approved" }
        },
        "required": ["state"]
      },
      "then": {
        "required": ["approved_by", "approved_at"]
      }
    }
  ],
  "$defs": {
    "UpstreamRef": {
      "type": "object",
      "required": ["revision_id", "artifact_kind"],
      "properties": {
        "revision_id": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "artifact_kind": {
          "enum": ["idea", "spec", "design", "tasks", "handoff"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
