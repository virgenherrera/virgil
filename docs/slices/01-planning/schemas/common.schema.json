{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.virgil.dev/planning-slice1/v1alpha1/common.schema.json",
  "title": "Virgil Planning Slice 1 Common Types",
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "Digest": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9+._-]*:[A-Fa-f0-9]{8,}$"
    },
    "SHA256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "ResourceRef": {
      "type": "object",
      "required": ["uri"],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1,
          "format": "uri-reference"
        },
        "revision": { "$ref": "#/$defs/NonEmptyString" },
        "digest": { "$ref": "#/$defs/Digest" }
      },
      "additionalProperties": false
    },
    "ImmutableResourceRef": {
      "type": "object",
      "required": ["uri", "digest"],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1,
          "format": "uri-reference"
        },
        "revision": { "$ref": "#/$defs/NonEmptyString" },
        "digest": { "$ref": "#/$defs/SHA256" }
      },
      "additionalProperties": false
    },
    "AdapterRef": {
      "type": "object",
      "required": ["adapter_id", "adapter_version"],
      "properties": {
        "adapter_id": { "$ref": "#/$defs/NonEmptyString" },
        "adapter_version": { "$ref": "#/$defs/NonEmptyString" }
      },
      "additionalProperties": false
    },
    "DogmaRef": {
      "type": "object",
      "required": ["dogma_id", "version", "digest", "source", "method_pack"],
      "properties": {
        "dogma_id": { "$ref": "#/$defs/NonEmptyString" },
        "version": { "$ref": "#/$defs/NonEmptyString" },
        "digest": { "$ref": "#/$defs/Digest" },
        "source": { "$ref": "#/$defs/ResourceRef" },
        "method_pack": {
          "type": "object",
          "required": ["pack_id", "pack_version"],
          "properties": {
            "pack_id": { "$ref": "#/$defs/NonEmptyString" },
            "pack_version": { "$ref": "#/$defs/NonEmptyString" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "TargetRef": {
      "type": "object",
      "required": ["uri", "baseline"],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1,
          "format": "uri-reference"
        },
        "canonical_path": {
          "type": "string",
          "minLength": 1
        },
        "baseline": { "$ref": "#/$defs/NonEmptyString" }
      },
      "additionalProperties": false
    },
    "ProjectRef": {
      "type": "object",
      "required": [
        "project_id",
        "target",
        "dogma_ref_id",
        "artifact_store_ref_id"
      ],
      "properties": {
        "project_id": { "$ref": "#/$defs/NonEmptyString" },
        "target": { "$ref": "#/$defs/TargetRef" },
        "dogma_ref_id": { "$ref": "#/$defs/NonEmptyString" },
        "artifact_store_ref_id": { "$ref": "#/$defs/NonEmptyString" }
      },
      "additionalProperties": false
    },
    "StorePolicy": {
      "type": "object",
      "required": ["policy_version", "read_allowlist", "write_allowlist"],
      "properties": {
        "policy_version": { "$ref": "#/$defs/NonEmptyString" },
        "read_allowlist": {
          "type": "array",
          "items": { "$ref": "#/$defs/NonEmptyString" },
          "uniqueItems": true
        },
        "write_allowlist": {
          "type": "array",
          "items": { "$ref": "#/$defs/NonEmptyString" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "ArtifactStoreRef": {
      "type": "object",
      "required": [
        "store_ref_id",
        "adapter",
        "project_id",
        "namespace",
        "policy"
      ],
      "properties": {
        "store_ref_id": { "$ref": "#/$defs/NonEmptyString" },
        "adapter": { "$ref": "#/$defs/AdapterRef" },
        "project_id": { "$ref": "#/$defs/NonEmptyString" },
        "namespace": { "$ref": "#/$defs/NonEmptyString" },
        "policy": { "$ref": "#/$defs/StorePolicy" },
        "resources": {
          "type": "array",
          "items": { "$ref": "#/$defs/ResourceRef" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "HostRef": {
      "type": "object",
      "required": ["adapter", "capabilities"],
      "properties": {
        "adapter": { "$ref": "#/$defs/AdapterRef" },
        "capabilities": {
          "type": "object",
          "required": ["supported"],
          "properties": {
            "supported": {
              "type": "array",
              "items": { "$ref": "#/$defs/NonEmptyString" },
              "uniqueItems": true
            },
            "guarantees": {
              "type": "array",
              "items": { "$ref": "#/$defs/NonEmptyString" },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "RunRef": {
      "type": "object",
      "required": ["run_id", "change_id", "project_id", "baseline"],
      "properties": {
        "run_id": { "$ref": "#/$defs/NonEmptyString" },
        "change_id": { "$ref": "#/$defs/NonEmptyString" },
        "project_id": { "$ref": "#/$defs/NonEmptyString" },
        "baseline": { "$ref": "#/$defs/NonEmptyString" }
      },
      "additionalProperties": false
    },
    "ActorRef": {
      "type": "object",
      "required": ["actor_id", "kind", "authority"],
      "properties": {
        "actor_id": { "$ref": "#/$defs/NonEmptyString" },
        "kind": {
          "enum": ["human", "agent", "service"]
        },
        "authority": {
          "type": "array",
          "items": { "$ref": "#/$defs/NonEmptyString" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "SourceProvenance": {
      "type": "object",
      "required": ["kind", "captured_at"],
      "properties": {
        "kind": {
          "enum": ["human_input", "project_document", "external_system", "replay_fixture"]
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": { "$ref": "#/$defs/ResourceRef" }
      },
      "additionalProperties": false
    },
    "ObjectPointer": {
      "type": "object",
      "required": ["object_id", "kind"],
      "properties": {
        "object_id": { "$ref": "#/$defs/NonEmptyString" },
        "kind": { "$ref": "#/$defs/NonEmptyString" },
        "revision": { "$ref": "#/$defs/NonEmptyString" },
        "resource": { "$ref": "#/$defs/ResourceRef" }
      },
      "additionalProperties": false
    },
    "Diagnostic": {
      "type": "object",
      "required": ["code", "severity", "scope", "condition", "next_action"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "severity": {
          "enum": ["info", "warning", "error"]
        },
        "scope": { "$ref": "#/$defs/NonEmptyString" },
        "condition": { "$ref": "#/$defs/NonEmptyString" },
        "next_action": { "$ref": "#/$defs/NonEmptyString" },
        "missing_capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/NonEmptyString" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "NextAction": {
      "type": "object",
      "required": ["operation", "condition"],
      "properties": {
        "operation": {
          "enum": ["virgil.init", "virgil.new", "virgil.continue", "none"]
        },
        "condition": { "$ref": "#/$defs/NonEmptyString" }
      },
      "additionalProperties": false
    }
  }
}
