{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.virgil.dev/planning-slice1/v1alpha1/revision-lifecycle-event.schema.json",
  "title": "Virgil Revision Lifecycle Event Record",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_version",
    "kind",
    "revision_id",
    "artifact_kind",
    "change_id",
    "project_id",
    "operation",
    "request_id",
    "idempotency_key",
    "actor",
    "timestamp",
    "run_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "virgil.dev/revision-lifecycle-event/v1alpha1"
    },
    "protocol_version": {
      "const": "virgil.dev/planning-slice1/v1alpha1"
    },
    "kind": {
      "enum": [
        "revision_drafted",
        "revision_submitted",
        "revision_approved",
        "revision_withdrawn",
        "revision_superseded"
      ]
    },
    "revision_id": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "artifact_kind": {
      "enum": ["idea", "spec", "design", "tasks", "handoff"]
    },
    "change_id": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "operation": {
      "const": "virgil.continue"
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "idempotency_key": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "actor": {
      "$ref": "common.schema.json#/$defs/ActorRef"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "run_ref": {
      "$ref": "common.schema.json#/$defs/RunRef"
    },
    "approved_by": {
      "$ref": "common.schema.json#/$defs/ActorRef"
    },
    "rationale": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "reason": {
      "enum": ["request_changes", "abandoned", "pivot"]
    },
    "superseded_by": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": { "const": "revision_approved" }
        },
        "required": ["kind"]
      },
      "then": {
        "required": ["approved_by", "rationale"]
      }
    },
    {
      "if": {
        "properties": {
          "kind": { "const": "revision_withdrawn" }
        },
        "required": ["kind"]
      },
      "then": {
        "required": ["reason"]
      }
    },
    {
      "if": {
        "properties": {
          "kind": { "const": "revision_superseded" }
        },
        "required": ["kind"]
      },
      "then": {
        "required": ["superseded_by"]
      }
    }
  ],
  "additionalProperties": false
}
