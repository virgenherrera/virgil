{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.virgil.dev/planning-slice1/v1alpha1/project-initialized-event.schema.json",
  "title": "Virgil project_initialized Event Record",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_version",
    "event_id",
    "kind",
    "occurred_at",
    "operation",
    "project_id",
    "request_id",
    "request_digest",
    "idempotency_key",
    "causation_id",
    "actor",
    "dogma_ref",
    "project_ref",
    "artifact_store_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "virgil.dev/project-initialized-event/v1alpha1"
    },
    "protocol_version": {
      "const": "virgil.dev/planning-slice1/v1alpha1"
    },
    "event_id": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "kind": {
      "const": "project_initialized"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "operation": {
      "const": "virgil.init"
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "request_digest": {
      "$ref": "common.schema.json#/$defs/SHA256"
    },
    "idempotency_key": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "causation_id": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "actor": {
      "$ref": "common.schema.json#/$defs/ActorRef"
    },
    "dogma_ref": {
      "$ref": "common.schema.json#/$defs/DogmaRef"
    },
    "project_ref": {
      "$ref": "common.schema.json#/$defs/ProjectRef"
    },
    "artifact_store_ref": {
      "$ref": "common.schema.json#/$defs/ArtifactStoreRef"
    }
  },
  "additionalProperties": false
}
