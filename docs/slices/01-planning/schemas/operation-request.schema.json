{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.virgil.dev/planning-slice1/v1alpha1/operation-request.schema.json",
  "title": "Virgil OperationRequest",
  "type": "object",
  "required": [
    "protocol_version",
    "operation",
    "request_id",
    "idempotency_key",
    "dogma_ref",
    "project_ref",
    "artifact_store_ref",
    "host",
    "actor",
    "input"
  ],
  "properties": {
    "protocol_version": {
      "const": "virgil.dev/planning-slice2/v1alpha1"
    },
    "operation": {
      "enum": ["virgil.init", "virgil.write", "virgil.transition"]
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "idempotency_key": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "dogma_ref": {
      "$ref": "common.schema.json#/$defs/DogmaRef"
    },
    "project_ref": {
      "$ref": "common.schema.json#/$defs/ProjectRef"
    },
    "artifact_store_ref": {
      "$ref": "common.schema.json#/$defs/ArtifactStoreRef"
    },
    "host": {
      "$ref": "common.schema.json#/$defs/HostRef"
    },
    "run_ref": {
      "$ref": "common.schema.json#/$defs/RunRef"
    },
    "actor": {
      "$ref": "common.schema.json#/$defs/ActorRef"
    },
    "input": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": { "const": "virgil.init" }
        },
        "required": ["operation"]
      },
      "then": {
        "not": { "required": ["run_ref"] },
        "properties": {
          "input": { "$ref": "#/$defs/InitInput" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": { "const": "virgil.write" }
        },
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "input": { "$ref": "#/$defs/WriteInput" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": { "const": "virgil.transition" }
        },
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "input": { "$ref": "#/$defs/TransitionInput" }
        }
      }
    }
  ],
  "$defs": {
    "SelfHostAuthorization": {
      "type": "object",
      "required": ["decision_id", "authorized_by", "reason"],
      "properties": {
        "decision_id": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "authorized_by": {
          "$ref": "common.schema.json#/$defs/ActorRef"
        },
        "reason": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "InitInput": {
      "type": "object",
      "required": ["project_id"],
      "properties": {
        "project_id": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "self_host_authorization": {
          "$ref": "#/$defs/SelfHostAuthorization"
        }
      },
      "additionalProperties": false
    },
    "WriteInput": {
      "type": "object",
      "required": ["doc_kind", "content"],
      "properties": {
        "doc_kind": {
          "enum": ["idea", "requirement", "design", "task"]
        },
        "slug": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "category": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["backlog", "refined", "active", "done", "released"]
        },
        "refs": {
          "$ref": "doc-frontmatter.schema.json#/$defs/TaskRefs"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "doc_kind": { "enum": ["requirement", "design", "task"] } },
            "required": ["doc_kind"]
          },
          "then": {
            "required": ["slug"]
          }
        }
      ],
      "additionalProperties": false
    },
    "TransitionInput": {
      "type": "object",
      "required": ["task_slug", "new_status"],
      "properties": {
        "task_slug": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "new_status": {
          "enum": ["backlog", "refined", "active", "done", "released"]
        },
        "refs_update": {
          "$ref": "doc-frontmatter.schema.json#/$defs/TaskRefs"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
