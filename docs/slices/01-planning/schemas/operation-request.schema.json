{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.virgil.dev/planning-slice1/v1alpha1/operation-request.schema.json",
  "title": "Virgil OperationRequest",
  "type": "object",
  "required": [
    "protocol_version",
    "operation",
    "request_id",
    "idempotency_key",
    "dogma_ref",
    "project_ref",
    "artifact_store_ref",
    "host",
    "actor",
    "input"
  ],
  "properties": {
    "protocol_version": {
      "const": "virgil.dev/planning-slice1/v1alpha1"
    },
    "operation": {
      "enum": ["virgil.init", "virgil.new", "virgil.continue"]
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "idempotency_key": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "dogma_ref": {
      "$ref": "common.schema.json#/$defs/DogmaRef"
    },
    "project_ref": {
      "$ref": "common.schema.json#/$defs/ProjectRef"
    },
    "artifact_store_ref": {
      "$ref": "common.schema.json#/$defs/ArtifactStoreRef"
    },
    "host": {
      "$ref": "common.schema.json#/$defs/HostRef"
    },
    "run_ref": {
      "$ref": "common.schema.json#/$defs/RunRef"
    },
    "actor": {
      "$ref": "common.schema.json#/$defs/ActorRef"
    },
    "input": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": { "const": "virgil.init" }
        },
        "required": ["operation"]
      },
      "then": {
        "not": { "required": ["run_ref"] },
        "properties": {
          "input": { "$ref": "#/$defs/InitInput" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": { "const": "virgil.new" }
        },
        "required": ["operation"]
      },
      "then": {
        "not": { "required": ["run_ref"] },
        "properties": {
          "input": { "$ref": "#/$defs/NewInput" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": { "const": "virgil.continue" }
        },
        "required": ["operation"]
      },
      "then": {
        "required": ["run_ref"],
        "properties": {
          "input": { "$ref": "#/$defs/ContinueInput" }
        }
      }
    }
  ],
  "$defs": {
    "SelfHostAuthorization": {
      "type": "object",
      "required": ["decision_id", "authorized_by", "reason"],
      "properties": {
        "decision_id": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "authorized_by": {
          "$ref": "common.schema.json#/$defs/ActorRef"
        },
        "reason": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "InitInput": {
      "type": "object",
      "required": ["project_id"],
      "properties": {
        "project_id": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "self_host_authorization": {
          "$ref": "#/$defs/SelfHostAuthorization"
        }
      },
      "additionalProperties": false
    },
    "NewInput": {
      "type": "object",
      "required": ["change_id", "intent", "provenance"],
      "properties": {
        "change_id": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "intent": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "provenance": {
          "$ref": "common.schema.json#/$defs/SourceProvenance"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ResourceRef"
          }
        }
      },
      "additionalProperties": false
    },
    "ContinueInput": {
      "type": "object",
      "required": ["change_id", "entry"],
      "properties": {
        "change_id": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "entry": {
          "oneOf": [
            { "$ref": "#/$defs/AnswerEntry" },
            { "$ref": "#/$defs/ContentProposalEntry" },
            { "$ref": "#/$defs/ApprovalEntry" },
            { "$ref": "#/$defs/RecoveryEntry" }
          ]
        }
      },
      "additionalProperties": false
    },
    "AnswerEntry": {
      "type": "object",
      "required": ["kind", "answer"],
      "properties": {
        "kind": { "const": "answer" },
        "answer": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "ContentProposalEntry": {
      "type": "object",
      "required": ["kind", "artifact_kind", "content"],
      "properties": {
        "kind": { "const": "content_proposal" },
        "artifact_kind": {
          "enum": ["idea", "spec", "design", "tasks", "handoff"]
        },
        "content": {
          "$ref": "common.schema.json#/$defs/ResourceRef"
        }
      },
      "additionalProperties": false
    },
    "ApprovalEntry": {
      "type": "object",
      "required": [
        "kind",
        "artifact_id",
        "revision",
        "decision",
        "rationale"
      ],
      "properties": {
        "kind": { "const": "approval" },
        "artifact_id": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "revision": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "decision": {
          "enum": ["approved", "request_changes", "rejected"]
        },
        "rationale": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "RecoveryEntry": {
      "type": "object",
      "required": ["kind", "reason"],
      "properties": {
        "kind": { "const": "recovery_request" },
        "reason": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
