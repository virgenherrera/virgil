{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.virgil.dev/planning-slice1/v1alpha1/actor-script.schema.json",
  "title": "Virgil T0 ActorScript",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_version",
    "script_id",
    "script_revision",
    "actor",
    "actions"
  ],
  "properties": {
    "schema_version": {
      "const": "virgil.dev/scripted-actor/v1alpha1"
    },
    "protocol_version": {
      "const": "virgil.dev/planning-slice1/v1alpha1"
    },
    "script_id": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "script_revision": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "actor": {
      "$ref": "common.schema.json#/$defs/ActorRef"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ActorAction"
      }
    }
  },
  "$defs": {
    "EffectAttempt": {
      "type": "object",
      "required": ["kind", "resource", "capability", "requested"],
      "properties": {
        "kind": {
          "enum": ["read", "write", "external_call"]
        },
        "resource": {
          "$ref": "common.schema.json#/$defs/ResourceRef"
        },
        "capability": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "requested": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "ActorAction": {
      "type": "object",
      "required": ["action_id", "sequence", "kind", "process_id"],
      "properties": {
        "action_id": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "enum": [
            "invoke",
            "retry",
            "restart_process",
            "attempt_out_of_band_effect",
            "stop"
          ]
        },
        "process_id": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "retries_action_id": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "after_trace_kind": {
          "enum": [
            "instructions_delivered",
            "discovery_decision",
            "activation_decision",
            "operation_requested",
            "operation_decided",
            "context_requested",
            "context_delivered",
            "guard_result",
            "gate_result",
            "effect_observed",
            "stop",
            "retry",
            "escalation",
            "recovery",
            "outcome"
          ]
        },
        "operation_request": {
          "$ref": "operation-request.schema.json"
        },
        "effect_attempt": {
          "$ref": "#/$defs/EffectAttempt"
        },
        "reason": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": { "enum": ["invoke", "retry"] }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["operation_request"],
            "not": {
              "anyOf": [
                { "required": ["effect_attempt"] },
                { "required": ["reason"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "retry" }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["retries_action_id"]
          },
          "else": {
            "not": { "required": ["retries_action_id"] }
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "restart_process" }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["reason"],
            "not": {
              "anyOf": [
                { "required": ["operation_request"] },
                { "required": ["effect_attempt"] },
                { "required": ["retries_action_id"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "attempt_out_of_band_effect" }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["effect_attempt"],
            "not": {
              "anyOf": [
                { "required": ["operation_request"] },
                { "required": ["reason"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "stop" }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["reason"],
            "not": {
              "anyOf": [
                { "required": ["operation_request"] },
                { "required": ["effect_attempt"] }
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
