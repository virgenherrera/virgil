{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.virgil.dev/planning-slice1/v1alpha1/change-state.schema.json",
  "title": "Virgil Change State",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_version",
    "project_ref",
    "change_id",
    "operation",
    "state",
    "derived_step",
    "intent",
    "provenance",
    "idempotency",
    "original_request",
    "created_at",
    "resolved_context",
    "event",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "const": "virgil.dev/change-state/v1alpha1"
    },
    "protocol_version": {
      "const": "virgil.dev/planning-slice1/v1alpha1"
    },
    "project_ref": {
      "$ref": "common.schema.json#/$defs/ProjectRef"
    },
    "change_id": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "operation": {
      "const": "virgil.new"
    },
    "state": {
      "const": "created"
    },
    "derived_step": {
      "const": "idea"
    },
    "intent": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/SourceProvenance"
    },
    "idempotency": {
      "$ref": "#/$defs/IdempotencyRecord"
    },
    "original_request": {
      "$ref": "operation-request.schema.json"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_context": {
      "$ref": "operation-result.schema.json#/$defs/Context"
    },
    "event": {
      "$ref": "#/$defs/EventPointer"
    },
    "resources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/ChangeResource"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "role": { "const": "project_authority" }
            },
            "required": ["role"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": { "const": "event_log" }
            },
            "required": ["role"]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  },
  "$defs": {
    "IdempotencyRecord": {
      "type": "object",
      "required": ["key", "request_digest", "original_request_id"],
      "properties": {
        "key": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "request_digest": {
          "$ref": "common.schema.json#/$defs/SHA256"
        },
        "original_request_id": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "EventPointer": {
      "type": "object",
      "required": ["event_id", "kind", "line_number", "resource"],
      "properties": {
        "event_id": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "kind": {
          "const": "change_created"
        },
        "line_number": {
          "type": "integer",
          "minimum": 1
        },
        "resource": {
          "$ref": "common.schema.json#/$defs/ImmutableResourceRef"
        }
      },
      "additionalProperties": false
    },
    "ChangeResource": {
      "type": "object",
      "required": ["role", "resource"],
      "properties": {
        "role": {
          "enum": ["project_authority", "event_log"]
        },
        "resource": {
          "$ref": "common.schema.json#/$defs/ImmutableResourceRef"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
