{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.virgil.dev/planning-slice1/v1alpha1/virgil-config.schema.json",
  "title": "Virgil Config",
  "description": "virgil.json, the repo-docs adapter control file published at the target root by virgil.init and updated by virgil.new to carry the active change.",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_version",
    "project_id",
    "dogma_ref",
    "adapter",
    "managed_root",
    "created_at",
    "created_by",
    "idempotency",
    "original_request",
    "resolved_context"
  ],
  "properties": {
    "schema_version": {
      "const": "virgil.dev/config/v1alpha1"
    },
    "protocol_version": {
      "const": "virgil.dev/planning-slice1/v1alpha1"
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "dogma_ref": {
      "$ref": "common.schema.json#/$defs/DogmaRef"
    },
    "adapter": {
      "$ref": "common.schema.json#/$defs/AdapterRef"
    },
    "managed_root": {
      "const": "docs/"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "$ref": "common.schema.json#/$defs/ActorRef"
    },
    "idempotency": {
      "$ref": "#/$defs/IdempotencyRecord"
    },
    "original_request": {
      "$ref": "operation-request.schema.json"
    },
    "resolved_context": {
      "$ref": "operation-result.schema.json#/$defs/Context"
    },
    "active_change": {
      "$ref": "#/$defs/ActiveChange"
    }
  },
  "$defs": {
    "IdempotencyRecord": {
      "type": "object",
      "required": ["key", "request_digest", "original_request_id"],
      "properties": {
        "key": { "$ref": "common.schema.json#/$defs/NonEmptyString" },
        "request_digest": { "$ref": "common.schema.json#/$defs/SHA256" },
        "original_request_id": { "$ref": "common.schema.json#/$defs/NonEmptyString" }
      },
      "additionalProperties": false
    },
    "ActiveChange": {
      "type": "object",
      "required": [
        "change_id",
        "intention",
        "run_id",
        "created_at",
        "provenance",
        "idempotency",
        "original_request",
        "resolved_context"
      ],
      "properties": {
        "change_id": { "$ref": "common.schema.json#/$defs/NonEmptyString" },
        "intention": { "$ref": "common.schema.json#/$defs/NonEmptyString" },
        "run_id": { "$ref": "common.schema.json#/$defs/NonEmptyString" },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "provenance": { "$ref": "common.schema.json#/$defs/SourceProvenance" },
        "idempotency": { "$ref": "#/$defs/IdempotencyRecord" },
        "original_request": { "$ref": "operation-request.schema.json" },
        "resolved_context": { "$ref": "operation-result.schema.json#/$defs/Context" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
