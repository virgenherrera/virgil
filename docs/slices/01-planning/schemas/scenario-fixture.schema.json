{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.virgil.dev/planning-slice1/v1alpha1/scenario-fixture.schema.json",
  "title": "Virgil Validation ScenarioFixture",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_version",
    "fixture_id",
    "fixture_revision",
    "layer",
    "target_repo",
    "initial_request",
    "actor_profile",
    "adapter_profile",
    "runtime_capabilities",
    "expected_interaction",
    "expected_events",
    "expected_artifacts",
    "expected_effects",
    "expected_target_diff",
    "prohibited_effects",
    "context_budget",
    "expected_outcome"
  ],
  "properties": {
    "schema_version": {
      "const": "virgil.dev/validation-fixture/v1alpha1"
    },
    "protocol_version": {
      "const": "virgil.dev/planning-slice1/v1alpha1"
    },
    "fixture_id": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "fixture_revision": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "layer": {
      "enum": ["T0", "T1", "T2"]
    },
    "target_repo": {
      "$ref": "common.schema.json#/$defs/TargetRef"
    },
    "initial_request": {
      "$ref": "operation-request.schema.json"
    },
    "actor_profile": {
      "$ref": "#/$defs/ActorProfile"
    },
    "adapter_profile": {
      "$ref": "#/$defs/AdapterProfile"
    },
    "runtime_capabilities": {
      "$ref": "common.schema.json#/$defs/HostRef"
    },
    "expected_interaction": {
      "$ref": "#/$defs/ExpectedInteraction"
    },
    "expected_events": {
      "type": "array",
      "items": { "$ref": "#/$defs/ObjectExpectation" }
    },
    "expected_artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/ObjectExpectation" }
    },
    "expected_effects": {
      "type": "array",
      "items": { "$ref": "#/$defs/ObjectExpectation" }
    },
    "expected_target_diff": {
      "$ref": "#/$defs/DiffExpectation"
    },
    "expected_checkpoints": {
      "type": "array",
      "items": { "$ref": "#/$defs/CheckpointExpectation" }
    },
    "prohibited_effects": {
      "type": "array",
      "items": { "$ref": "#/$defs/ProhibitedEffect" }
    },
    "context_budget": {
      "$ref": "#/$defs/ContextBudget"
    },
    "expected_outcome": {
      "$ref": "#/$defs/ExpectedOutcome"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "layer": { "const": "T0" }
        },
        "required": ["layer"]
      },
      "then": {
        "properties": {
          "actor_profile": {
            "properties": {
              "mode": { "enum": ["scripted", "replay"] }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "ComponentProfile": {
      "type": "object",
      "required": ["adapter", "capabilities"],
      "properties": {
        "adapter": {
          "$ref": "common.schema.json#/$defs/AdapterRef"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/NonEmptyString"
          },
          "uniqueItems": true
        },
        "config_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        }
      },
      "additionalProperties": false
    },
    "ActorProfile": {
      "type": "object",
      "required": ["mode", "component"],
      "properties": {
        "mode": {
          "enum": ["scripted", "replay", "local_agent", "frontier_agent", "human_assisted"]
        },
        "component": { "$ref": "#/$defs/ComponentProfile" },
        "script": {
          "$ref": "common.schema.json#/$defs/ImmutableResourceRef"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": { "enum": ["scripted", "replay"] }
            },
            "required": ["mode"]
          },
          "then": {
            "required": ["script"]
          }
        }
      ],
      "additionalProperties": false
    },
    "AdapterProfile": {
      "type": "object",
      "required": ["host", "artifact_store", "isolation", "model_provider"],
      "properties": {
        "host": {
          "$ref": "common.schema.json#/$defs/HostRef"
        },
        "artifact_store": {
          "$ref": "common.schema.json#/$defs/ArtifactStoreRef"
        },
        "isolation": { "$ref": "#/$defs/ComponentProfile" },
        "model_provider": { "$ref": "#/$defs/ComponentProfile" }
      },
      "additionalProperties": false
    },
    "InteractionStep": {
      "type": "object",
      "required": ["step_id", "kind"],
      "properties": {
        "step_id": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "kind": {
          "enum": [
            "instructions_delivered",
            "discovery_decision",
            "activation_decision",
            "operation_requested",
            "operation_decided",
            "context_requested",
            "context_delivered",
            "guard_result",
            "gate_result",
            "effect_observed",
            "stop",
            "retry",
            "escalation",
            "recovery",
            "outcome"
          ]
        },
        "operation": {
          "enum": ["virgil.init", "virgil.new", "virgil.continue"]
        },
        "diagnostic_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "request_id": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "operation_status": {
          "enum": ["success", "needs_input", "blocked", "unsupported", "error"]
        },
        "next_operation": {
          "enum": ["virgil.init", "virgil.new", "virgil.continue", "none"]
        },
        "replayed_from_request_id": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "process_id": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "effect_kind": {
          "enum": ["read", "write", "external_call"]
        },
        "policy_decision": {
          "enum": ["authorized", "denied", "unsupported"]
        },
        "occurred": {
          "type": "boolean"
        },
        "resource_pattern": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "OrderConstraint": {
      "type": "object",
      "required": ["before", "after"],
      "properties": {
        "before": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "after": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "ExpectedInteraction": {
      "type": "object",
      "required": ["required_steps", "order_constraints", "max_retries"],
      "properties": {
        "required_steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/InteractionStep" }
        },
        "order_constraints": {
          "type": "array",
          "items": { "$ref": "#/$defs/OrderConstraint" }
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "ObjectExpectation": {
      "type": "object",
      "required": ["kind", "min_count", "max_count"],
      "properties": {
        "kind": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "min_count": {
          "type": "integer",
          "minimum": 0
        },
        "max_count": {
          "type": "integer",
          "minimum": 0
        },
        "required_fields": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/NonEmptyString"
          },
          "uniqueItems": true
        },
        "field_equals": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^/"
          },
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean", "null"]
          }
        }
      },
      "additionalProperties": false
    },
    "CheckpointExpectation": {
      "type": "object",
      "required": [
        "checkpoint_id",
        "after_step",
        "relative_to",
        "target_diff",
        "store_diff",
        "expected_events",
        "expected_artifacts"
      ],
      "properties": {
        "checkpoint_id": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "after_step": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "relative_to": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "target_diff": {
          "$ref": "#/$defs/DiffExpectation"
        },
        "store_diff": {
          "$ref": "#/$defs/DiffExpectation"
        },
        "expected_events": {
          "type": "array",
          "items": { "$ref": "#/$defs/ObjectExpectation" }
        },
        "expected_artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/ObjectExpectation" }
        }
      },
      "additionalProperties": false
    },
    "DiffExpectation": {
      "type": "object",
      "required": ["mode", "allowed_paths"],
      "properties": {
        "mode": {
          "enum": ["empty", "exact", "managed_only"]
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/NonEmptyString"
          },
          "uniqueItems": true
        },
        "expected_changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "change_type"],
            "properties": {
              "path": {
                "$ref": "common.schema.json#/$defs/NonEmptyString"
              },
              "change_type": {
                "enum": ["added", "modified", "deleted"]
              },
              "digest": {
                "$ref": "common.schema.json#/$defs/Digest"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": { "const": "empty" }
            },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "allowed_paths": { "maxItems": 0 },
              "expected_changes": { "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": { "enum": ["exact", "managed_only"] }
            },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "allowed_paths": { "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": { "const": "exact" }
            },
            "required": ["mode"]
          },
          "then": {
            "required": ["expected_changes"]
          }
        }
      ],
      "additionalProperties": false
    },
    "ProhibitedEffect": {
      "type": "object",
      "required": ["kind", "scope", "reason"],
      "properties": {
        "kind": {
          "enum": ["read", "write", "external_call"]
        },
        "scope": {
          "enum": [
            "matching_resource_pattern",
            "outside_effective_policy",
            "by_request"
          ]
        },
        "resource_pattern": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "request_id": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "reason": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": { "const": "matching_resource_pattern" }
            },
            "required": ["scope"]
          },
          "then": {
            "required": ["resource_pattern"],
            "not": { "required": ["request_id"] }
          }
        },
        {
          "if": {
            "properties": {
              "scope": { "const": "outside_effective_policy" }
            },
            "required": ["scope"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["resource_pattern"] },
                { "required": ["request_id"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "scope": { "const": "by_request" }
            },
            "required": ["scope"]
          },
          "then": {
            "required": ["request_id"]
          }
        }
      ],
      "additionalProperties": false
    },
    "ContextBudget": {
      "type": "object",
      "required": [
        "read_allowlist",
        "denylist",
        "required_sources",
        "max_bytes"
      ],
      "properties": {
        "read_allowlist": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/NonEmptyString"
          },
          "uniqueItems": true
        },
        "denylist": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/NonEmptyString"
          },
          "uniqueItems": true
        },
        "required_sources": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/NonEmptyString"
          },
          "uniqueItems": true
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "ExpectedOutcome": {
      "type": "object",
      "required": ["status", "reason"],
      "properties": {
        "status": {
          "enum": ["passed", "failed"]
        },
        "failure_class": {
          "enum": [
            "virgil_failure",
            "model_capability_failure",
            "environment_failure",
            "fixture_failure"
          ]
        },
        "reason": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "const": "failed" }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["failure_class"]
          },
          "else": {
            "not": { "required": ["failure_class"] }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
